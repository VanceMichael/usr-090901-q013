{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embodied intelligence lab schedule request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schedule_id",
    "timezone",
    "requests"
  ],
  "properties": {
    "schedule_id": {"type": "string", "pattern": "^[a-z0-9-]{8,48}$"},
    "timezone": {"type": "string", "const": "Asia/Shanghai"},
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "device_id", "zone_id", "operator_id", "starts_at", "ends_at", "priority"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]{3,24}$"},
          "device_id": {"type": "string"},
          "zone_id": {"type": "string"},
          "operator_id": {"type": "string"},
          "starts_at": {"type": "string", "format": "date-time"},
          "ends_at": {"type": "string", "format": "date-time"},
          "priority": {"type": "integer", "minimum": 1, "maximum": 5},
          "charging_minutes_after": {"type": "integer", "minimum": 0, "maximum": 240}
        }
      }
    }
  }
}
